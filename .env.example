# Copy to .env for local development. On Netlify, set these in
# Site configuration → Environment variables.

# Postgres. On Netlify, adding a Netlify Database sets NETLIFY_DB_URL
# automatically; locally use
# the docker-compose database (npm run db:up).
DATABASE_URL=postgres://foodtoken:foodtoken@localhost:5440/foodtoken

# Public URL of the site, used in magic-link emails.
APP_URL=http://localhost:5180

# Comma-separated emails that can open /admin.
ADMIN_EMAILS=you@example.com

# Resend (https://resend.com). Without these, local dev prints the sign-in
# link to the API console; production refuses to send.
RESEND_API_KEY=
EMAIL_FROM=Food Token <signin@yourdomain.com>

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts gift card numbers, PINs and e-gift links. Losing it makes stored
# cards unreadable; changing it requires re-encrypting. Back it up.
CARD_ENCRYPTION_KEY=

# true = simulated deposits, fake addresses, demo inventory, demo banner.
DEMO_MODE=true

# ---- Real deposits (EVM: Ethereum, Base, BNB Smart Chain) ----
# Extended PUBLIC key from `npm run wallet:keygen`. The recovery phrase
# itself never goes here.
EVM_XPUB=

# Alchemy: API key (RPC + prices) and the Notify auth token (adds each new
# deposit address to the webhooks).
ALCHEMY_API_KEY=
ALCHEMY_AUTH_TOKEN=

# One Address Activity webhook per network, pointing at
# <APP_URL>/api/webhooks/alchemy. A network is live once both are set.
ALCHEMY_ETHEREUM_WEBHOOK_ID=
ALCHEMY_ETHEREUM_SIGNING_KEY=
ALCHEMY_BASE_WEBHOOK_ID=
ALCHEMY_BASE_SIGNING_KEY=
ALCHEMY_BSC_WEBHOOK_ID=
ALCHEMY_BSC_SIGNING_KEY=

# Smallest deposit credited, in USD (smaller ones are held, not credited).
MIN_DEPOSIT_USD_ETHEREUM=20
MIN_DEPOSIT_USD_BASE=2
MIN_DEPOSIT_USD_BSC=2

# Company wallet addresses (comma-separated). Transfers from these to a
# deposit address (gas top-ups) are never credited to the customer.
TREASURY_ADDRESSES=
