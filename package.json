{
  "name": "foodtoken",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --env-file=.env --watch server/dev.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env --watch server/dev.js",
    "db:up": "docker compose up -d",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "build": "vite build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.73.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
